# FitTracker - variables de entorno requeridas
# Copiar a docker/.env (gitignored) y rellenar con valores reales.
# NUNCA commitear el archivo .env.

# PostgreSQL
POSTGRESQL_DB_USERNAME=postgres
POSTGRESQL_DB_PASSWORD=<contrasena-fuerte-local>
POSTGRESQL_DB_PORT=5432

# JWT (generar con: openssl rand -hex 32)
# Debe ser IDENTICO en auth-service y api-gateway (en docker se inyecta via compose)
JWT_SECRET=<generar-con-openssl-rand-hex-32>
JWT_EXPIRATION=3600000

# Config Server (Spring Cloud Config)
# Repositorio Git oficial de configuracion de FitTracker.
CONFIG_GIT_URI=https://github.com/<usuario>/<repo-configuracion>.git
CONFIG_GIT_BRANCH=main

# Puertos
EUREKA_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888
AUTH_SERVER_PORT=8080
USER_SERVER_PORT=8083
CALCULATOR_SERVER_PORT=8081
ROUTINE_SERVER_PORT=8082
WORKOUT_SERVER_PORT=8084
API_GATEWAY_PORT=8222
